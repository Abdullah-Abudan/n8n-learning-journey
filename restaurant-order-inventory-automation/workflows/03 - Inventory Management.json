    {
      "parameters": {
        "jsCode": "const orderId = $('When Executed by Another Workflow').first().json.orderId;\n\nreturn [{\n  json: {\n    success: false,\n    alreadyProcessed: true,\n    orderId,\n    message: 'Existing stock movements found. No additional deduction was made. Manual review is required.'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        -240
      ],
      "id": "6da2ce5e-586b-4b3e-a93a-ca5eb7168fe4",
      "name": "Return Already Processed"
    },
    {
      "parameters": {
        "jsCode": "const orderInput = $('When Executed by Another Workflow').first().json;\nconst orderId = orderInput.orderId;\n\nconst movements = $('Check Existing Stock Movements').all()\n  .map(item => item.json);\n\nconst recipes = $('Get All Recipes - Recovery').all()\n  .map(item => item.json);\n\nfunction result(success, message) {\n  return [{\n    json: {\n      success,\n      alreadyProcessed: true,\n      orderId,\n      message\n    }\n  }];\n}\n\ntry {\n  if (!orderId || !orderInput.items || movements.length === 0) {\n    return result(false, 'Missing order data or stock movements. Manual review is required.');\n  }\n\n  // Parse the original order items\n  const products = orderInput.items.split(',');\n  const parsedItems = products.map(item => {\n    const match = item.trim().match(/^(.+?)\\s*x\\s*(\\d+)$/i);\n\n    if (!match) {\n      throw new Error(`Invalid order item: ${item}`);\n    }\n\n    return {\n      product: match[1].trim(),\n      quantity: Number(match[2])\n    };\n  });\n\n  // Calculate the expected ingredient quantities\n  const expected = {};\n\n  for (const item of parsedItems) {\n    const productRecipes = recipes.filter(recipe =>\n      String(recipe.product || '').trim().toLowerCase() ===\n      item.product.toLowerCase()\n    );\n\n    if (productRecipes.length === 0) {\n      throw new Error(`Recipe not found for ${item.product}`);\n    }\n\n    for (const recipe of productRecipes) {\n      const ingredient = String(recipe.ingredient || '').trim();\n      const quantityPerUnit = Number(recipe.quantityPerUnit);\n\n      if (!ingredient || !Number.isFinite(quantityPerUnit) || quantityPerUnit <= 0) {\n        throw new Error('Invalid recipe data');\n      }\n\n      expected[ingredient] =\n        (expected[ingredient] || 0) + item.quantity * quantityPerUnit;\n    }\n  }\n\n  // Validate and total the existing stock movements\n  const actual = {};\n  const movementIds = new Set();\n\n  for (const movement of movements) {\n    if (\n      movement.orderId !== orderId ||\n      String(movement.type || '').trim().toUpperCase() !== 'OUT' ||\n      !movement.movementId ||\n      movementIds.has(movement.movementId)\n    ) {\n      throw new Error('Invalid or duplicate stock movement found');\n    }\n\n    movementIds.add(movement.movementId);\n\n    const ingredient = String(movement.ingredient || '').trim();\n    const quantity = Number(movement.quantity);\n\n    if (!ingredient || !Number.isFinite(quantity) || quantity <= 0) {\n      throw new Error('Invalid stock movement data');\n    }\n\n    actual[ingredient] = (actual[ingredient] || 0) + quantity;\n  }\n\n  // Compare expected and actual quantities\n  const ingredients = new Set([\n    ...Object.keys(expected),\n    ...Object.keys(actual)\n  ]);\n\n  for (const ingredient of ingredients) {\n    const expectedKey = Object.keys(expected).find(\n      key => key.toLowerCase() === ingredient.toLowerCase()\n    );\n\n    const actualKey = Object.keys(actual).find(\n      key => key.toLowerCase() === ingredient.toLowerCase()\n    );\n\n    const expectedQuantity = expectedKey ? expected[expectedKey] : 0;\n    const actualQuantity = actualKey ? actual[actualKey] : 0;\n\n    if (Math.abs(expectedQuantity - actualQuantity) > 0.000001) {\n      throw new Error(`Quantity mismatch for ${ingredient}`);\n    }\n  }\n\n  return result(\n    true,\n    'Existing stock movements match the order. No additional deduction was made.'\n  );\n\n} catch (error) {\n  return result(\n    false,\n    `${error.message}. Manual review is required.`\n  );\n}"
      },
