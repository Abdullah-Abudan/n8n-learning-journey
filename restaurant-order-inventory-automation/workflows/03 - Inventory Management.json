      "id": "8c116818-d3e3-4eef-8dd9-f2fcaa669d17",
      "name": "Get All Recipes",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "dOGPssnCGh9tXyyA",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const orderItems = $input.all();\nconst recipes = $('Get All Recipes').all();\n\nconst requiredIngredients = {};\n\nfor (const item of orderItems) {\n  const { orderId, product, quantity } = item.json;\n\n  const productRecipes = recipes.filter(\n    recipe => recipe.json.product.trim().toLowerCase()\n      === product.trim().toLowerCase()\n  );\n\n  if (productRecipes.length === 0) {\n    throw new Error(`Recipe not found for: ${product}`);\n  }\n\n  for (const recipe of productRecipes) {\n    const ingredient = recipe.json.ingredient;\n    const quantityPerUnit = Number(recipe.json.quantityPerUnit);\n\n    const totalQuantity = quantity * quantityPerUnit;\n\n    requiredIngredients[ingredient] =\n      (requiredIngredients[ingredient] || 0) + totalQuantity;\n  }\n}\n\nreturn Object.entries(requiredIngredients).map(\n  ([ingredient, quantity]) => ({\n    json: {\n      orderId: orderItems[0].json.orderId,\n      ingredient,\n      quantity\n    }\n  })\n);\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -688,
        -48
      ],
      "id": "314a3961-2b95-4fc2-8d3f-a646feab233b",
      "name": "Calculate Required Ingredients"
    },
