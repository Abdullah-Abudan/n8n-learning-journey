    {
      "parameters": {
        "jsCode": "const requiredItems = $('Calculate Required Ingredients').all();\nconst inventoryItems = $input.all();\n\nconst results = [];\n\nfor (const required of requiredItems) {\n  const ingredient = required.json.ingredient;\n  const requiredQuantity = Number(required.json.quantity);\n\n  const stockIndex = inventoryItems.findIndex(\n    item => item.json.ingredient.trim().toLowerCase()\n      === ingredient.trim().toLowerCase()\n  );\n\n  if (stockIndex === -1) {\n    results.push({\n      json: {\n        orderId: required.json.orderId,\n        ingredient,\n        requiredQuantity,\n        availableQuantity: 0,\n        rowNumber: null,\n        sufficient: false,\n        reason: 'Ingredient not found in inventory'\n      }\n    });\n    continue;\n  }\n\n  const stock = inventoryItems[stockIndex].json;\n  const availableQuantity = Number(stock.quantity);\n\n  results.push({\n    json: {\n      orderId: required.json.orderId,\n      ingredient,\n      requiredQuantity,\n      availableQuantity,\n      rowNumber: stock.row_number,\n      sufficient: availableQuantity >= requiredQuantity,\n      reason: availableQuantity >= requiredQuantity\n        ? 'Stock available'\n        : 'Insufficient stock'\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        80
      ],
      "id": "4add15f3-7818-4c3d-8114-6a81db9d19e6",
      "name": "Validate Stock"
    },
    {
      "parameters": {
        "jsCode": "\nconst checks = $input.all();\n\nconst insufficientItems = checks.filter(\n  item => item.json.sufficient === false\n);\n\nconst allAvailable =\n  checks.length > 0 && insufficientItems.length === 0;\n\nreturn checks.map(item => ({\n  json: {\n    ...item.json,\n    allAvailable\n  }\n}));\n"
      },
