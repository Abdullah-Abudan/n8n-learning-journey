    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst isRecovery = data.alreadyProcessed === true;\n\nreturn [{\n  json: {\n    orderId: data.orderId,\n    success: true,\n    alreadyProcessed: isRecovery,\n    message: isRecovery\n      ? 'Previous stock movements verified. No new deduction was made.'\n      : 'Inventory deducted successfully.',\n    movementsRecorded: isRecovery\n      ? undefined\n      : $input.all().length\n  }\n}];"
      },
