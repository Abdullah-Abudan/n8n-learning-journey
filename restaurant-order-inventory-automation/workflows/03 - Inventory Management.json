    {
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst orderId = input.orderId;\nconst itemsText = input.items;\n\nif (!orderId || !itemsText) {\n  throw new Error('Missing orderId or items');\n}\n\nconst products = itemsText.split(',');\n\nconst parsedItems = products.map((item) => {\n  const match = item.trim().match(/^(.+?)\\s*x\\s*(\\d+)$/i);\n\n  if (!match) {\n    throw new Error(`Invalid item format: ${item}`);\n  }\n\n  const product = match[1].trim();\n  const quantity = Number(match[2]);\n\n  if (!product || !Number.isInteger(quantity) || quantity <= 0) {\n    throw new Error(`Invalid product or quantity: ${item}`);\n  }\n\n  return {\n    json: {\n      orderId,\n      product,\n      quantity\n    }\n  };\n});\n\nreturn parsedItems;\n"
      },
